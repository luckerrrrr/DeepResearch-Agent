# ===== 大模型（任意兼容 OpenAI 接口的服务：OpenAI / DeepSeek / 通义千问 / Kimi 等）=====
LLM_MODEL_ID="gpt-4o-mini"
LLM_API_KEY="your-api-key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_TIMEOUT=120
# 推理模型的推理强度（none/low/medium/high）；模型不支持该参数时留空
LLM_REASONING_EFFORT="low"
# 服务不支持 response_format=json_object 时设为 false
LLM_JSON_MODE=true

# ===== 评估用的裁判模型（可选，默认与上面相同；建议用不同模型以降低自评偏差）=====
JUDGE_MODEL_ID=""
JUDGE_REASONING_EFFORT="medium"

# ===== 网页搜索（SerpApi，免费版每月 250 次：https://serpapi.com）=====
SERPAPI_API_KEY="your-serpapi-key"
SEARCH_HL="zh-cn"
SEARCH_GL=""

# ===== 向量模型：local（fastembed 本地模型，免费离线）或 openai =====
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"
